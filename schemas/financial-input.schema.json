{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feasibility Study Financial Input",
  "type": "object",
  "required": ["currency", "initial_investment", "discount_rate", "years"],
  "properties": {
    "currency": {"type": "string", "minLength": 3},
    "initial_investment": {"type": "number", "minimum": 0},
    "opening_cash": {"type": "number"},
    "financing": {"type": "number"},
    "discount_rate": {"type": "number", "exclusiveMinimum": -1},
    "years": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["year", "revenue", "cogs", "opex"],
        "properties": {
          "year": {"type": ["integer", "string"]},
          "revenue": {"type": "number"}, "cogs": {"type": "number"}, "opex": {"type": "number"},
          "taxes": {"type": "number"}, "capex": {"type": "number"},
          "working_capital_change": {"type": "number"}, "debt_service": {"type": "number"},
          "cads": {"type": ["number", "null"]}
        }
      }
    }
  }
}
